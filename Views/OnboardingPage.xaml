<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RavenMobile.Controls"
    x:Class="RavenMobile.Views.OnboardingPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#05060A" Offset="0"/>
            <GradientStop Color="#071025" Offset="0.48"/>
            <GradientStop Color="#05060A" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*,Auto"
          Padding="22,28,22,24">

        <Grid InputTransparent="True">

            <Border WidthRequest="280"
                    HeightRequest="280"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-120,-130,0"
                    Opacity="0.35"
                    StrokeThickness="0">

                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5"
                                         Radius="0.75">
                        <GradientStop Color="#2D6BFF" Offset="0"/>
                        <GradientStop Color="#002D6BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="180"/>
                </Border.StrokeShape>
            </Border>

            <Border WidthRequest="230"
                    HeightRequest="230"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="-120,0,0,20"
                    Opacity="0.22"
                    StrokeThickness="0">

                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5"
                                         Radius="0.75">
                        <GradientStop Color="#8A4DFF" Offset="0"/>
                        <GradientStop Color="#008A4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="180"/>
                </Border.StrokeShape>
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="0"
                             Spacing="22"
                             VerticalOptions="Center">

            <Border WidthRequest="92"
                    HeightRequest="92"
                    HorizontalOptions="Center"
                    Stroke="#2D6BFF"
                    StrokeThickness="1.2">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#182746" Offset="0"/>
                        <GradientStop Color="#0B1020" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="34"/>
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#2D6BFF"
                            Radius="26"
                            Offset="0,0"
                            Opacity="0.35"/>
                </Border.Shadow>

                <Label Text="ᚱ"
                       TextColor="#8FB0FF"
                       FontSize="48"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <Label Text="Raven"
                   TextColor="White"
                   FontSize="42"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <CarouselView x:Name="IntroCarousel"
                          HeightRequest="310"
                          IndicatorView="IntroIndicator">

                <CarouselView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Alıcı QR oluşturur|Dosya almak için AL modunu başlat. Raven yerel Wi-Fi ağı oluşturur ve QR kod gösterir.|📥</x:String>
                        <x:String>Gönderici QR okutur|Göndermek istediğin dosyaları seç, QR kodu okut ve bağlantıyı otomatik başlat.|📤</x:String>
                        <x:String>Hızlı aktarım başlar|Cihaz listesi yok, karmaşa yok. Dosyalar doğrudan yerel Wi-Fi üzerinden aktarılır.|⚡</x:String>
                    </x:Array>
                </CarouselView.ItemsSource>

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="22"
                                Margin="2,8"
                                Stroke="#24304C"
                                StrokeThickness="1">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,1">
                                    <GradientStop Color="#111827" Offset="0"/>
                                    <GradientStop Color="#080B12" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="34"/>
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="#000000"
                                        Offset="0,12"
                                        Radius="28"
                                        Opacity="0.45"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="16"
                                                 VerticalOptions="Center">

                                <Label Text="{Binding ., Converter={StaticResource OnboardingIconConverter}}"
                                       FontSize="54"
                                       HorizontalOptions="Center"/>

                                <Label Text="{Binding ., Converter={StaticResource OnboardingTitleConverter}}"
                                       TextColor="White"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>

                                <Label Text="{Binding ., Converter={StaticResource OnboardingDescriptionConverter}}"
                                       TextColor="#9AA4B8"
                                       FontSize="14"
                                       LineBreakMode="WordWrap"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="IntroIndicator"
                           HorizontalOptions="Center"
                           IndicatorColor="#2A3142"
                           SelectedIndicatorColor="#2D6BFF"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="12">

            <controls:AnimatedButton Text="Başla"
                    Clicked="StartButton_Clicked"
                    HeightRequest="58"
                    CornerRadius="24"
                    BackgroundColor="#2D6BFF"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"/>

            <controls:AnimatedButton Text="Atla"
                    Clicked="SkipButton_Clicked"
                    HeightRequest="48"
                    CornerRadius="20"
                    BackgroundColor="#111722"
                    BorderColor="#26314A"
                    BorderWidth="1"
                    TextColor="#B8C2D9"
                    FontSize="14"/>

            <Label Text="Raven • Local Wi-Fi Transfer"
                   TextColor="#3F485D"
                   FontSize="11"
                   HorizontalOptions="Center"
                   Margin="0,6,0,0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>