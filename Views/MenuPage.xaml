<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RavenMobile.Controls"
    x:Class="RavenMobile.Views.MenuPage"
    Title="Raven"
    BackgroundColor="#05060A"
    Padding="0">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- BACKGROUND GLOW -->
        <Grid InputTransparent="True">

            <Border WidthRequest="240"
                    HeightRequest="240"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="-90,-80,0,0"
                    Opacity="0.35"
                    StrokeThickness="0">

                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5"
                                         Radius="0.75">
                        <GradientStop Color="#2D6BFF" Offset="0"/>
                        <GradientStop Color="#002D6BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="180"/>
                </Border.StrokeShape>
            </Border>

            <Border WidthRequest="210"
                    HeightRequest="210"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,-100,-40"
                    Opacity="0.18"
                    StrokeThickness="0">

                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5"
                                         Radius="0.75">
                        <GradientStop Color="#8A4DFF" Offset="0"/>
                        <GradientStop Color="#008A4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="180"/>
                </Border.StrokeShape>
            </Border>

        </Grid>

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="22,36,22,22"
                             Spacing="15">

            <Border WidthRequest="72"
                    HeightRequest="72"
                    BackgroundColor="#CC101827"
                    Stroke="#2D6BFF"
                    StrokeThickness="1.2">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28"/>
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#2D6BFF"
                            Radius="26"
                            Offset="0,0"
                            Opacity="0.34"/>
                </Border.Shadow>

                <Label Text="ᚱ"
                       TextColor="#8FB0FF"
                       FontSize="41"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label Text="Raven"
                       TextColor="White"
                       FontSize="32"
                       FontAttributes="Bold"/>

                <Label Text="Fast. Local. Simple."
                       TextColor="#8EA3D9"
                       FontSize="13"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <Border Padding="12"
                    BackgroundColor="#66101722"
                    Stroke="#24304A"
                    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>

                <Label Text="QR ile hızlı dosya aktarımı"
                       TextColor="#8C95AA"
                       FontSize="12"/>
            </Border>
        </VerticalStackLayout>

        <!-- MENU ITEMS -->
        <CollectionView Grid.Row="1"
                        x:Name="MenuCollection"
                        SelectionMode="Single"
                        SelectionChanged="MenuCollection_SelectionChanged"
                        Margin="12,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="0"
                            Margin="0,6"
                            BackgroundColor="{Binding CardBackgroundColor}"
                            Stroke="{Binding CardStrokeColor}"
                            StrokeThickness="1.1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Radius="18"
                                    Offset="0,8"
                                    Opacity="0.28"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="4,Auto,*"
                              ColumnSpacing="13"
                              Padding="0,14,14,14">

                            <BoxView Grid.Column="0"
                                     BackgroundColor="{Binding ActiveBarColor}"
                                     WidthRequest="4"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Fill"/>

                            <Border Grid.Column="1"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{Binding IconBackgroundColor}"
                                    Stroke="{Binding CardStrokeColor}"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17"/>
                                </Border.StrokeShape>

                                <Label Text="{Binding Icon}"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="2"
                                                 VerticalOptions="Center">

                                <Label Text="{Binding Title}"
                                       TextColor="{Binding TitleColor}"
                                       FontSize="15"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Subtitle}"
                                       TextColor="{Binding SubtitleColor}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- FOOTER -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="22,16,22,24"
                             Spacing="4">

            <BoxView HeightRequest="1"
                     Color="#1D2433"
                     Margin="0,0,0,10"/>

            <Label Text="Raven v1.0"
                   TextColor="#596273"
                   FontSize="12"/>

            <Label Text="Local Wi-Fi Transfer"
                   TextColor="#3F485D"
                   FontSize="11"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>