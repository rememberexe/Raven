<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RavenMobile.Controls"
    x:Class="RavenMobile.Views.AboutPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#05060A" Offset="0"/>
            <GradientStop Color="#071025" Offset="0.45"/>
            <GradientStop Color="#05060A" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <!-- BACKGROUND GLOWS -->
        <Grid InputTransparent="True">

            <Border WidthRequest="260"
                    HeightRequest="260"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-100,-110,0"
                    Opacity="0.32"
                    StrokeThickness="0">

                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5"
                                         Radius="0.75">
                        <GradientStop Color="#2D6BFF" Offset="0"/>
                        <GradientStop Color="#002D6BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="180"/>
                </Border.StrokeShape>
            </Border>

            <Border WidthRequest="220"
                    HeightRequest="220"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Margin="-120,0,0,0"
                    Opacity="0.20"
                    StrokeThickness="0">

                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5"
                                         Radius="0.75">
                        <GradientStop Color="#8A4DFF" Offset="0"/>
                        <GradientStop Color="#008A4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="180"/>
                </Border.StrokeShape>
            </Border>

        </Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20,28,20,30"
                                 Spacing="18">

                <!-- HEADER -->
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14">

                    <controls:AnimatedButton Text="☰"
                            Clicked="MenuButton_Clicked"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="18"
                            BackgroundColor="#111827"
                            BorderColor="#25304A"
                            BorderWidth="1"
                            TextColor="White"
                            FontSize="22"
                            Padding="0"/>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">

                        <Label Text="Hakkında"
                               TextColor="White"
                               FontSize="30"
                               FontAttributes="Bold"/>

                        <Label Text="Raven uygulamasının amacı ve çalışma mantığı."
                               TextColor="#8790A3"
                               FontSize="13"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- HERO -->
                <Border Padding="22"
                        Stroke="#2D6BFF"
                        StrokeThickness="1.2">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#121E38" Offset="0"/>
                            <GradientStop Color="#070A11" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="36"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#2D6BFF"
                                Radius="26"
                                Offset="0,0"
                                Opacity="0.22"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Border WidthRequest="96"
                                HeightRequest="96"
                                HorizontalOptions="Center"
                                BackgroundColor="#101827"
                                Stroke="#2D6BFF"
                                StrokeThickness="1.2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="36"/>
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="#2D6BFF"
                                        Radius="28"
                                        Offset="0,0"
                                        Opacity="0.35"/>
                            </Border.Shadow>

                            <Label Text="ᚱ"
                                   TextColor="#8FB0FF"
                                   FontSize="54"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Raven"
                                   TextColor="White"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>

                            <Label Text="Local Wi-Fi Transfer"
                                   TextColor="#8EA3D9"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <Label Text="Raven, cihaz listesiyle uğraşmadan QR kod üzerinden iki cihaz arasında hızlı ve sade dosya aktarımı yapmayı hedefleyen bir yerel Wi-Fi transfer uygulamasıdır."
                               TextColor="#AEB8CD"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               HorizontalTextAlignment="Center"/>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              Margin="0,6,0,0">

                            <Border Padding="13"
                                    BackgroundColor="#101722"
                                    Stroke="#24304A"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="QR"
                                           TextColor="#6F7890"
                                           FontSize="11"/>

                                    <Label Text="Kolay eşleşme"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="13"
                                    BackgroundColor="#101722"
                                    Stroke="#24304A"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Wi-Fi"
                                           TextColor="#6F7890"
                                           FontSize="11"/>

                                    <Label Text="Hızlı aktarım"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- HOW IT WORKS -->
                <Border Padding="18"
                        BackgroundColor="#0F121B"
                        Stroke="#222A3C"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <Label Text="Nasıl çalışır?"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="13">

                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#172642"
                                    Stroke="#2D6BFF"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17"/>
                                </Border.StrokeShape>

                                <Label Text="1"
                                       TextColor="#8FB0FF"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">

                                <Label Text="Alıcı QR oluşturur"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"/>

                                <Label Text="AL moduna geçen cihaz yerel bağlantı bilgilerini QR kod içine yerleştirir."
                                       TextColor="#8C95AA"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="#222A3C"/>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="13">

                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#172642"
                                    Stroke="#2D6BFF"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17"/>
                                </Border.StrokeShape>

                                <Label Text="2"
                                       TextColor="#8FB0FF"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">

                                <Label Text="Gönderici QR okutur"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"/>

                                <Label Text="Gönderici dosyaları seçer, QR kodu okutur ve bağlantıyı otomatik başlatır."
                                       TextColor="#8C95AA"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="#222A3C"/>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="13">

                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#172642"
                                    Stroke="#2D6BFF"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17"/>
                                </Border.StrokeShape>

                                <Label Text="3"
                                       TextColor="#8FB0FF"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">

                                <Label Text="Dosyalar aktarılır"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"/>

                                <Label Text="Dosyalar internet gerekmeden yerel Wi-Fi bağlantısı üzerinden aktarılır."
                                       TextColor="#8C95AA"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- FEATURES -->
                <Border Padding="18"
                        BackgroundColor="#0F121B"
                        Stroke="#222A3C"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <Label Text="Öne çıkanlar"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">

                            <Border Padding="14"
                                    BackgroundColor="#101722"
                                    Stroke="#24304A"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="📁"
                                           FontSize="26"/>

                                    <Label Text="Çoklu dosya"
                                           TextColor="White"
                                           FontSize="14"
                                           FontAttributes="Bold"/>

                                    <Label Text="Birden fazla dosyayı tek seferde aktar."
                                           TextColor="#7F8AA3"
                                           FontSize="11"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="14"
                                    BackgroundColor="#101722"
                                    Stroke="#24304A"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🖼️"
                                           FontSize="26"/>

                                    <Label Text="Önizleme"
                                           TextColor="White"
                                           FontSize="14"
                                           FontAttributes="Bold"/>

                                    <Label Text="Görsel dosyaları listede önizle."
                                           TextColor="#7F8AA3"
                                           FontSize="11"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="14"
                                    BackgroundColor="#101722"
                                    Stroke="#24304A"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="🕘"
                                           FontSize="26"/>

                                    <Label Text="Geçmiş"
                                           TextColor="White"
                                           FontSize="14"
                                           FontAttributes="Bold"/>

                                    <Label Text="Transfer kayıtlarını uygulama içinde gör."
                                           TextColor="#7F8AA3"
                                           FontSize="11"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="14"
                                    BackgroundColor="#101722"
                                    Stroke="#24304A"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="⚙️"
                                           FontSize="26"/>

                                    <Label Text="Ayarlar"
                                           TextColor="White"
                                           FontSize="14"
                                           FontAttributes="Bold"/>

                                    <Label Text="Titreşim ve transfer davranışlarını düzenle."
                                           TextColor="#7F8AA3"
                                           FontSize="11"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- PRIVACY -->
                <Border Padding="18"
                        BackgroundColor="#0F121B"
                        Stroke="#222A3C"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#142A1C"
                                Stroke="#1D7C3A"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>

                            <Label Text="🔒"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">

                            <Label Text="Gizlilik"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <Label Text="Raven dosyaları internet üzerinden göndermez. Aktarım, cihazlar arasında yerel bağlantı ile yapılır. Transfer geçmişi ve ayarlar cihaz içinde saklanır."
                                   TextColor="#9AA4B8"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- APP INFO -->
                <Border Padding="18"
                        BackgroundColor="#0F121B"
                        Stroke="#222A3C"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Label Text="Uygulama bilgileri"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10">

                            <Label Text="Sürüm"
                                   TextColor="#7F8AA3"
                                   FontSize="13"/>

                            <Label Grid.Column="1"
                                   Text="{Binding VersionText}"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="1"
                                   Text="Platform"
                                   TextColor="#7F8AA3"
                                   FontSize="13"/>

                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding PlatformText}"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="2"
                                   Text="Geliştirici"
                                   TextColor="#7F8AA3"
                                   FontSize="13"/>

                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Yusuf Arda Yılmaz"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Label Text="Raven • Local Wi-Fi Transfer"
                       TextColor="#3F485D"
                       FontSize="11"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>