<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RavenMobile.Controls"
    x:Class="RavenMobile.Views.SettingsPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#05060A" Offset="0"/>
            <GradientStop Color="#071025" Offset="0.45"/>
            <GradientStop Color="#05060A" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20,28"
                             Spacing="18">

            <!-- HEADER -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">

                <controls:AnimatedButton Text="☰"
                        Clicked="MenuButton_Clicked"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="18"
                        BackgroundColor="#111827"
                        BorderColor="#25304A"
                        BorderWidth="1"
                        TextColor="White"
                        FontSize="22"
                        Padding="0"/>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">

                    <Label Text="Ayarlar"
                           TextColor="White"
                           FontSize="30"
                           FontAttributes="Bold"/>

                    <Label Text="Raven davranışlarını buradan düzenle."
                           TextColor="#8790A3"
                           FontSize="13"/>
                </VerticalStackLayout>
            </Grid>

            <!-- STATUS -->
            <Border Padding="15"
                    BackgroundColor="#0F121B"
                    Stroke="#222A3C"
                    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

                    <Border WidthRequest="38"
                            HeightRequest="38"
                            BackgroundColor="#172642"
                            Stroke="#2D6BFF"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>

                        <Label Text="⚙️"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">

                        <Label Text="Durum"
                               TextColor="#70798E"
                               FontSize="12"/>

                        <Label Text="{Binding StatusText}"
                               TextColor="#F2F5FF"
                               FontSize="14"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- TRANSFER SETTINGS -->
            <Border Padding="18"
                    BackgroundColor="#0F121B"
                    Stroke="#222A3C"
                    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label Text="Transfer"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Transfer bitince titreşim"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"/>

                            <Label Text="Gönderim veya alım tamamlandığında kısa titreşim verir."
                                   TextColor="#7F8AA3"
                                   FontSize="12"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="1"
                                IsToggled="{Binding VibrateOnTransferComplete}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#222A3C"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Gönderimden sonra listeyi temizle"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"/>

                            <Label Text="Dosyalar başarıyla gönderilince seçili dosya listesi otomatik temizlenir."
                                   TextColor="#7F8AA3"
                                   FontSize="12"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="1"
                                IsToggled="{Binding AutoClearFilesAfterSend}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#222A3C"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Alıcı modu otomatik kapansın"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"/>

                            <Label Text="Dosya alımı tamamlanınca AL modu otomatik kapatılır."
                                   TextColor="#7F8AA3"
                                   FontSize="12"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="1"
                                IsToggled="{Binding AutoStopReceiveAfterTransfer}"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- APP SETTINGS -->
            <Border Padding="18"
                    BackgroundColor="#0F121B"
                    Stroke="#222A3C"
                    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label Text="Uygulama"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Tanıtım ekranını tekrar göster"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"/>

                            <Label Text="Uygulama yeniden açıldığında ilk açılış tanıtımı tekrar gösterilir."
                                   TextColor="#7F8AA3"
                                   FontSize="12"/>
                        </VerticalStackLayout>

                        <controls:AnimatedButton Grid.Column="1"
                                Text="Sıfırla"
                                Command="{Binding ResetOnboardingCommand}"
                                WidthRequest="86"
                                HeightRequest="44"
                                CornerRadius="17"
                                BackgroundColor="#20283A"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#222A3C"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Transfer geçmişini temizle"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"/>

                            <Label Text="Geçmiş sayfasındaki tüm kayıtları siler."
                                   TextColor="#7F8AA3"
                                   FontSize="12"/>
                        </VerticalStackLayout>

                        <controls:AnimatedButton Grid.Column="1"
                                Text="Temizle"
                                Command="{Binding ClearHistoryCommand}"
                                WidthRequest="90"
                                HeightRequest="44"
                                CornerRadius="17"
                                BackgroundColor="#241B22"
                                BorderColor="#55303A"
                                BorderWidth="1"
                                TextColor="#FFB4C0"
                                FontSize="13"
                                FontAttributes="Bold"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="Raven • Settings"
                   TextColor="#3F485D"
                   FontSize="11"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>